# Copy this file to .env and fill in your own values.
# Never commit the real .env — it's already in .gitignore.

# Atlas (cloud — see ../../Day4/ATLAS_SETUP_GUIDE.md). Required for deployment
# (Day 6) — Render can't reach a local database on your laptop.
MONGO_URI=mongodb+srv://<db-username>:<db-password>@<cluster-name>.mongodb.net/campus-issue-tracker?retryWrites=true&w=majority

# Or, for local dev only (see ../../Day4/LOCAL_MONGODB_SETUP_GUIDE.md):
# MONGO_URI=mongodb://localhost:27017/campus-issue-tracker

PORT=5000

# Local dev: the CRA dev server's origin. In production, set this to your
# deployed frontend's real URL (e.g. https://campus-issue-tracker.vercel.app)
# — see ../DEPLOYMENT_GUIDE.md.
CLIENT_URL=http://localhost:3000